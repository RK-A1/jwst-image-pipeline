# Secrets — never commit
.env
.env.local

# Python and tooling
__pycache__/
*.pyc
.venv/
.pytest_cache/

# macOS
.DS_Store

# Astro / Airflow local runtime
.astro/
logs/
airflow.db
airflow.cfg
webserver_config.py

# Pipeline data. Everything under include/data is local state except two things:
# the label log, which records paid model calls, and the published dataset.
include/data/*
!include/data/labels/
include/data/labels/*
!include/data/labels/raw_labels.jsonl
!include/data/dataset/
include/data/dataset/*
!include/data/dataset/jwst_space_images.parquet
!include/data/dataset/jwst_space_images.csv
!include/data/dataset/rejected.parquet
!include/data/dataset/rejected.csv
!include/data/dataset/manifest.json
